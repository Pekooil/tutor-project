# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — the Calyxa extension id the web→extension auth bridge targets
# (chrome.runtime.sendMessage). Absent OR WRONG → the bridge is a SILENT no-op:
# web auth still succeeds, the extension just never signs itself in, and there
# is no error anywhere to notice it by (extension-bridge.ts returns early).
#
# ONE value for every environment. extension/wxt.config.ts pins the published
# CWS item's own public key, so a local unpacked build and the store build both
# load as gedmlagmmllpohdkdpeocpbnmofegnbm — no per-environment override needed.
# (Before 2026-07-25 that key was a locally-generated one deriving to a
# different id, bmmfbl…, which is why the bridge silently never fired in prod.)
NEXT_PUBLIC_CALYXA_EXTENSION_ID=gedmlagmmllpohdkdpeocpbnmofegnbm

# Server-only. NEVER prefix this with NEXT_PUBLIC_: it bypasses RLS
# entirely and must never reach the browser bundle (see ADR-003,
# /supabase/policies/README.md, /web/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The Anthropic BACKUP tutor path (ADR-052: OpenAI is the default
# provider; Claude Haiku is retained in-tree as the flip-back + eval baseline,
# selected via TUTOR_PROVIDER=anthropic below). Must never reach the browser
# bundle or the extension (ADR-008, locked key policy).
ANTHROPIC_API_KEY=

# Server-only. The voice proxies (/web/app/api/voice/*) hold these; they must
# never reach the browser bundle or the extension (ADR-010, locked key policy).
OPENAI_API_KEY=          # Whisper STT (POST /api/voice/stt) + the GPT-4o-mini tutor + study kits (ADR-052)
ELEVENLABS_API_KEY=      # ElevenLabs TTS (POST /api/voice/tts)
ELEVENLABS_VOICE_ID=     # default tutor voice id (not secret, but server-side config)

# ADR-052 (2026-07-17, supersedes ADR-038's default): the tutor provider seam.
# Unset/'openai' (DEFAULT) = OpenAI GPT-4o-mini. 'anthropic' = the retained
# Claude Haiku 4.5 backup path — the one-env-var rollback. STT/TTS providers
# are unaffected either way. STUDY_KIT_PROVIDER is the same switch for the
# study-kit generator (web/lib/study/generate.ts), deliberately independent so
# the two can be flipped separately.
TUTOR_PROVIDER=          # openai (default) | anthropic
STUDY_KIT_PROVIDER=      # openai (default) | anthropic

# Server-only. Gates every /api/cron/* route (Sprint 16 / ADR-036,
# web/lib/cron/auth.ts). Vercel sends this as `Authorization: Bearer
# <value>` when invoking a scheduled cron automatically; set the same
# value in the Vercel project's env vars. Never prefix NEXT_PUBLIC_.
CRON_SECRET=

# Server-only. Salts the HMAC-SHA256 hash written to
# sessions.page_url_hash (Sprint 16 / ADR-036, web/lib/privacy/url-hash.ts).
# Never prefix NEXT_PUBLIC_; never reused as any other secret's value.
URL_HASH_SALT=

# Server-only. Sprint 17 / Task 5 (ADR-043): the error-monitoring sink's
# ingest URL, read by web/lib/monitoring/init.ts's captureError() at CALL
# time (not module load) -- absent-tolerant by design, so leaving this unset
# is a no-op, never a boot failure. Never prefix NEXT_PUBLIC_: the extension
# and any web client code never hold this (or any monitoring secret) at all
# -- extension-originated errors relay through POST /api/errors instead,
# which alone reads this var, server-side only.
MONITORING_DSN=

# Server-only. Sprint 19 / Task 6 (ADR-045): the beta invite email send path
# (web/lib/email/invite.ts, called only from the service-role, CRON_SECRET-
# guarded POST /api/admin/invite). RESEND_API_KEY is a transactional-provider
# (Resend) credential; INVITE_FROM_EMAIL is a verified sender like
# `Calyxa <invites@your-domain>`. BOTH absent → sendInvite is a no-op and the
# admin route returns the cohort for a manual send instead (dev-safe). Never
# prefix NEXT_PUBLIC_; the extension never holds these (no-secret gate covers
# RESEND_API_KEY). CALYXA_STORE_URL (below) is the unlisted store link put in
# the email — set it once Task 7 has the listing URL (not secret).
RESEND_API_KEY=
INVITE_FROM_EMAIL=
CALYXA_STORE_URL=

# Server-only. Sprint 23 / Task 3 (ADR-050): Stripe billing. STRIPE_SECRET_KEY
# is the secret API key (`sk_test_...` in test mode, `sk_live_...` in prod) —
# NEVER prefix NEXT_PUBLIC_ and never let it reach any bundle (the Sprint 18
# no-secret CI gate greps the built extension for it too; the extension links
# out to the web /billing page and never imports Stripe — ADR-006/ADR-050).
# STRIPE_PRICE_ID is the Pro plan's Stripe Price id (`price_...`, not secret but
# server-side config); both absent → the checkout route returns a clean 500.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Server-only. Sprint 23 / Task 4 (ADR-050): the Stripe webhook signing secret
# (`whsec_...`) that POST /api/billing/webhook uses to verify the raw-body
# signature (stripe.webhooks.constructEvent). Get it from the Stripe CLI
# (`stripe listen --forward-to localhost:3000/api/billing/webhook` prints a
# `whsec_...` for local dev) or from the webhook endpoint's "Signing secret" in
# the Stripe Dashboard (Developers → Webhooks) for the deployed URL. Each
# endpoint (local vs prod) has its OWN secret — use the one matching where the
# events are delivered. An unverifiable signature is a hard 400, no processing;
# an unset secret makes the route a clean 500. Never prefix NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=

# Dev-only note: email confirmation is off in the Supabase Auth dashboard
# (Authentication > Providers > Email > "Confirm email") for the hosted
# "calyxa" project, so signup is testable without SMTP. Re-enable before
# launch — there is no MCP tool to toggle this, it must be flipped by hand.

# Dev-only note: the extension's background worker (extension/src/lib/api.ts)
# targets this server at http://localhost:3000 via a hardcoded API_BASE
# constant, not an env var — the extension holds no secret to gate behind
# one. No action needed here; this just documents the matching value.
