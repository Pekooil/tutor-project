# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_: it bypasses RLS
# entirely and must never reach the browser bundle (see ADR-003,
# /supabase/policies/README.md, /web/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The Claude proxy (/web/app/api/ai/turn) holds this; it must
# never reach the browser bundle or the extension (ADR-008, locked key policy).
ANTHROPIC_API_KEY=

# Server-only. The voice proxies (/web/app/api/voice/*) hold these; they must
# never reach the browser bundle or the extension (ADR-010, locked key policy).
OPENAI_API_KEY=          # Whisper STT (POST /api/voice/stt)
ELEVENLABS_API_KEY=      # ElevenLabs TTS (POST /api/voice/tts)
ELEVENLABS_VOICE_ID=     # default tutor voice id (not secret, but server-side config)

# Server-only. Gates every /api/cron/* route (Sprint 16 / ADR-036,
# web/lib/cron/auth.ts). Vercel sends this as `Authorization: Bearer
# <value>` when invoking a scheduled cron automatically; set the same
# value in the Vercel project's env vars. Never prefix NEXT_PUBLIC_.
CRON_SECRET=

# Server-only. Salts the HMAC-SHA256 hash written to
# sessions.page_url_hash (Sprint 16 / ADR-036, web/lib/privacy/url-hash.ts).
# Never prefix NEXT_PUBLIC_; never reused as any other secret's value.
URL_HASH_SALT=

# Server-only. Sprint 17 / Task 5 (ADR-043): the error-monitoring sink's
# ingest URL, read by web/lib/monitoring/init.ts's captureError() at CALL
# time (not module load) -- absent-tolerant by design, so leaving this unset
# is a no-op, never a boot failure. Never prefix NEXT_PUBLIC_: the extension
# and any web client code never hold this (or any monitoring secret) at all
# -- extension-originated errors relay through POST /api/errors instead,
# which alone reads this var, server-side only.
MONITORING_DSN=

# Server-only. Sprint 19 / Task 6 (ADR-045): the beta invite email send path
# (web/lib/email/invite.ts, called only from the service-role, CRON_SECRET-
# guarded POST /api/admin/invite). RESEND_API_KEY is a transactional-provider
# (Resend) credential; INVITE_FROM_EMAIL is a verified sender like
# `Calyxa <invites@your-domain>`. BOTH absent → sendInvite is a no-op and the
# admin route returns the cohort for a manual send instead (dev-safe). Never
# prefix NEXT_PUBLIC_; the extension never holds these (no-secret gate covers
# RESEND_API_KEY). CALYXA_STORE_URL (below) is the unlisted store link put in
# the email — set it once Task 7 has the listing URL (not secret).
RESEND_API_KEY=
INVITE_FROM_EMAIL=
CALYXA_STORE_URL=

# Dev-only note: email confirmation is off in the Supabase Auth dashboard
# (Authentication > Providers > Email > "Confirm email") for the hosted
# "calyxa" project, so signup is testable without SMTP. Re-enable before
# launch — there is no MCP tool to toggle this, it must be flipped by hand.

# Dev-only note: the extension's background worker (extension/src/lib/api.ts)
# targets this server at http://localhost:3000 via a hardcoded API_BASE
# constant, not an env var — the extension holds no secret to gate behind
# one. No action needed here; this just documents the matching value.
