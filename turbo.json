{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".wxt/**", ".next/**", "!.next/cache/**"],
      "env": [
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "ELEVENLABS_API_KEY",
        "ELEVENLABS_VOICE_ID",
        "ELEVENLABS_API_BASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    }
  }
}
